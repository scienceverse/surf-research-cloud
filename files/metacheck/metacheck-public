#!/usr/bin/env bash
# Managed by the metacheck SURF Research Cloud component (scienceverse/surf-research-cloud).
#
# Opens or closes the metacheck paper report app to anyone.
#   sudo metacheck-public on       anyone can use the app at https://<workspace>/metacheck/
#   sudo metacheck-public off      SRAM login required
#   metacheck-public status        show which it is
# The progress page (/metacheck-status) always requires the SRAM login.
set -euo pipefail

DIR=/opt/metacheck-component/nginx
DST=/etc/nginx/app-location-conf.d/metacheck.conf
HOST=$(hostname -f)

state() { grep -q "This is the PUBLIC variant" "$DST" 2>/dev/null && echo open || echo closed; }

# A later playbook run keeps this choice: it is the component parameter
# metacheck_public in the playbook's parameters file (root only).
remember() {
  python3 -I - "$1" <<'PY'
import json, os, sys
f = "/etc/metacheck-settings.json"
try:
    with open(f) as fh:
        s = json.load(fh)
except (OSError, ValueError):
    s = {}
s["metacheck_public"] = sys.argv[1]
tmp = f + ".tmp"
with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as fh:
    json.dump(s, fh, indent=2)
    fh.write("\n")
os.replace(tmp, f)
PY
}

use() {
  [ "$(id -u)" -eq 0 ] || { echo "Run as: sudo metacheck-public $1" >&2; exit 1; }
  [ -d /etc/nginx/app-location-conf.d ] || { echo "No SRC-Nginx on this workspace" >&2; exit 1; }
  cp "$DST" "$DST.previous" 2>/dev/null || true
  install -m 0644 -o root -g root "$DIR/metacheck-$2.conf" "$DST"
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx
    rm -f "$DST.previous"
  else
    nginx -t || true
    [ -f "$DST.previous" ] && mv "$DST.previous" "$DST"
    echo "nginx configuration error: previous setting restored" >&2
    exit 1
  fi
}

case "${1:-status}" in
  on)
    use on public
    remember true
    echo "The metacheck app is OPEN to anyone: https://$HOST/metacheck/"
    ;;
  off)
    use off login
    remember false
    echo "The metacheck app needs the SRAM login again: https://$HOST/metacheck/"
    ;;
  status)
    echo "metacheck app public: $(state)"
    ;;
  *)
    echo "Usage: metacheck-public on|off|status" >&2
    exit 2
    ;;
esac
