# Managed by the bibr SURF Research Cloud component (scienceverse/surf-research-cloud).
# Environment for bibr's Docker Compose stack (bibr serve + GLM-OCR + Redis).
# Settings reference: https://bibr.org/reference/settings/

# Production mode is forced by docker-compose.yml; these two are required by it.
AUTH_API_KEY={{ bibr_api_key_value }}
REDIS_PASSWORD={{ bibr_redis_password }}

# The bundled OCR server (GLM-OCR on SGLang, GPU).
OCR_BACKEND=glm-http
OCR_MODEL=glm-ocr
OCR_PROFILE=glm
OCR_API_KEY={{ bibr_ocr_api_key }}
# Share of GPU memory the OCR server reserves; leaves room for bibr's own models.
OCR_MEM_FRACTION_STATIC={{ bibr_ocr_mem_fraction }}

# Language model for the extraction step: Ollama on this workspace (default)
# or a cloud provider.
{% if bibr_llm_provider == 'ollama' %}
# Ollama is reached through bibr's OpenAI-compatible provider, because only
# that provider forwards reasoning_effort; "none" switches off the hidden
# reasoning step of models such as Qwen 3.5, which made every call 5 to 10
# times slower. host.docker.internal is the workspace's Docker bridge address,
# where Ollama listens (see docker-compose.override.yml and tasks/ollama.yml).
LLM_PROVIDER=openai
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL={{ bibr_llm_model }}
LLM_REASONING_EFFORT=none
LLM_REASONING_EFFORT_AUTHORS=none
LLM_REASONING_EFFORT_CITATIONS=none
# Free JSON instead of a strict output grammar: under the strict grammar a 4B
# model returned no affiliations; in JSON mode it returns them (tested).
LLM_INSTRUCTOR_MODE=json
# A local model answers one call at a time; allow for queueing.
LLM_TIMEOUT_SECONDS=120
{% else %}
LLM_PROVIDER={{ bibr_llm_provider }}
{% if bibr_llm_model != 'default' %}
LLM_MODEL={{ bibr_llm_model }}
{% endif %}
{% endif %}
{% if bibr_google_api_key != 'none' %}
GOOGLE_API_KEY={{ bibr_google_api_key }}
{% endif %}
{% if bibr_anthropic_api_key != 'none' %}
ANTHROPIC_API_KEY={{ bibr_anthropic_api_key }}
{% endif %}
{% if bibr_openai_api_key != 'none' and bibr_llm_provider != 'ollama' %}
LLM_API_KEY={{ bibr_openai_api_key }}
{% endif %}

# Reference enrichment through Crossref (needed for reference checking).
CROSSREF_ENRICH=true
{% if bibr_crossref_email != 'none' %}
CROSSREF_API_EMAIL={{ bibr_crossref_email }}
{% endif %}

# Builds bibr serve's GPU variant. bibr's Compose file gives that container no
# GPU, so its layout model and sentence splitter run on the CPU (measured: no
# GPU memory used), which leaves the GPU to the OCR server and Ollama.
WITH_GPU=true
SERVE_LOG_LEVEL=info
