# Managed by the bibr SURF Research Cloud component (scienceverse/surf-research-cloud).
# The PUBLIC entrance to bibr: no SRAM login. Switched on and off with
# `sudo bibr-public on|off`, which copies this file into
# /etc/nginx/app-location-conf.d/ or removes it again.
#
# nginx adds bibr's token to every request, so visitors need none and never
# see it. This file therefore contains the token: keep it root-only.
#
# Only uploads (POST) are limited per visitor (zone bibr_public, defined in
# /etc/nginx/conf.d/bibr-public-limit.conf); reading pages, polling a job and
# fetching its result are not. bibr itself also refuses work when busy
# (HTTP 429) and files over 50 MB.

location / {
    limit_req zone=bibr_public burst=10 nodelay;
    limit_req_status 429;

    proxy_pass http://127.0.0.1:{{ bibr_port }};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # replaces any Authorization header a visitor sends
    proxy_set_header Authorization "Bearer {{ bibr_api_key_value }}";
    proxy_read_timeout 900s;
    proxy_request_buffering off;
    client_max_body_size 55M;
}
