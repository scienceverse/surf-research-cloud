# Managed by the bibr SURF Research Cloud component (scienceverse/surf-research-cloud).
# Included from the SRC-Nginx server block (/etc/nginx/conf.d/tls_main.conf),
# which terminates TLS and defines /validate and @custom_401 for the SRAM
# login. Both locations require that login: they are for people in a browser
# (for example bibr's API documentation at /bibr/docs). Programs on other
# workspaces reach bibr over the SRC private network instead (see README).

# bibr extraction API (bibr serve on port {{ bibr_port }}). Besides the SRAM
# login, bibr itself requires its bearer token (/etc/bibr/api_key).
location /bibr/ {
    error_page 401 = @custom_401;
    auth_request /validate;

    proxy_pass http://127.0.0.1:{{ bibr_port }}/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 900s;
    proxy_request_buffering off;
    client_max_body_size {{ bibr_max_upload }};
}

# Installation progress (plain text), useful while the bibr images build.
location = /bibr-status {
    error_page 401 = @custom_401;
    auth_request /validate;
    alias {{ bibr_log_dir }}/status.txt;
    default_type text/plain;
}
