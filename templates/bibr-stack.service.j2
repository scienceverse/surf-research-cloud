# Managed by the metacheck SURF Research Cloud component.
# One-shot background build and start of bibr's Docker Compose stack, plus the
# Ollama model pull. The containers restart on boot through Docker itself.
[Unit]
Description=Build and start the bibr extraction stack (bibr serve, GLM-OCR, Redis)
After=docker.service network-online.target{% if metacheck_llm_provider == 'ollama' %} ollama.service{% endif %}

Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=BIBR_DIR={{ metacheck_bibr_dir }}
{% if metacheck_llm_provider == 'ollama' %}
Environment=OLLAMA_MODEL={{ metacheck_llm_model }}
{% endif %}
ExecStart={{ metacheck_root }}/bin/bibr-stack-up.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
