# Managed by the metacheck SURF Research Cloud component (scienceverse/surf-research-cloud).
# Read by R processes of the shiny user (the metacheck paper report app).
{% if metacheck_bibr_url_value | length > 0 %}

# bibr extraction server: on this workspace, or another workspace on the
# SRC private network (BIBR_REMOTE=true). The app offers it first.
BIBR_API_URL={{ metacheck_bibr_url_value }}
BIBR_API_KEY={{ metacheck_bibr_key_value }}
BIBR_REMOTE={{ 'true' if metacheck_bibr_remote else 'false' }}
{% endif %}
{% if metacheck_grobid_url_value | length > 0 %}

# The GROBID server the web interface converts a PDF with when bibr fails
# (metacheck_grobid_url).
METACHECK_GROBID_URL={{ metacheck_grobid_url_value }}
{% endif %}
{% if metacheck_grobid_local | bool %}

# GROBID on this workspace (metacheck_grobid_url = local): the paper report
# app offers it first, as "Use GROBID on this server".
GROBID_LOCAL_URL={{ metacheck_grobid_url_value }}
GROBID_LOCAL_SERVER=true
{% endif %}
{% if metacheck_docx_local | bool %}

# LibreOffice on this workspace (metacheck_docx_converter = local): makes a
# PDF of a Word file for GROBID when there is no bibr.
METACHECK_DOCX_URL=http://127.0.0.1:3000
{% endif %}
{% if metacheck_local_llm %}

# Local language model (Ollama on this workspace) for the LLM power check.
OLLAMA_BASE_URL={{ ollama_url }}
METACHECK_LLM_MODEL={{ metacheck_llm_model }}
{% elif metacheck_shared_llm | bool %}

# The bibr workspace's language model, on the SRC private network, for the LLM
# power check (shared through nginx there, with bibr's token).
OLLAMA_BASE_URL={{ metacheck_shared_llm_url }}
VLLM_API_KEY={{ metacheck_bibr_key_value }}
METACHECK_LLM_MODEL={{ metacheck_llm_model }}
METACHECK_LLM_SHARED=true
{% elif metacheck_url_llm | bool %}

# Another server's language model (metacheck_llm = url), through its
# OpenAI-compatible address, for the LLM power check and the installed modules.
OLLAMA_BASE_URL={{ metacheck_url_llm_base }}
VLLM_API_KEY={{ metacheck_llm_api_key if metacheck_llm_api_key != 'none' else '' }}
METACHECK_LLM_MODEL={{ metacheck_llm_model }}
METACHECK_LLM_NAME="{{ metacheck_llm_name_value | replace('"', '') }}"
{% endif %}
{% if metacheck_llm_max_tokens != 'none' and (metacheck_local_llm | bool or metacheck_shared_llm | bool or metacheck_url_llm | bool) %}

# The longest answer the model may give, in tokens (metacheck_llm_max_tokens).
METACHECK_LLM_MAX_TOKENS={{ metacheck_llm_max_tokens }}
{% endif %}
{% if metacheck_llm_first_url != 'none' %}

# Models the power check tries before the model above, which stays the
# fallback (metacheck_llm_first_*, llm_first.R); each check is logged in
# METACHECK_LLM_FIRST_LOG, which the server watch summarises daily.
METACHECK_LLM_FIRST_URL={{ metacheck_llm_first_url_value }}
METACHECK_LLM_FIRST_MODELS={{ metacheck_llm_first_models | regex_replace('\s+', '') }}
METACHECK_LLM_FIRST_KEY={{ metacheck_llm_first_api_key if metacheck_llm_first_api_key != 'none' else '' }}
METACHECK_LLM_FIRST_NAME="{{ metacheck_llm_first_name_value | replace('"', '') }}"
METACHECK_LLM_FIRST_LOG=/var/lib/metacheck-watch/llm-first.log
{% endif %}

# Modules installed from GitHub (metacheck_modules, metacheck::module_install()),
# which the app and the web interface find by name.
METACHECK_MODULES_DIR={{ metacheck_modules_dir }}

# Anonymous use counts of the app (metacheck's usage_record()) and of the web
# interface (api_usage.csv); `sudo metacheck-usage` summarises them.
METACHECK_USAGE_DIR={{ metacheck_usage_dir }}

# Keys for the app's optional cloud model providers.
{% if metacheck_mistral_api_key != 'none' %}
MISTRAL_API_KEY={{ metacheck_mistral_api_key }}
{% endif %}
{% if metacheck_groq_api_key != 'none' %}
GROQ_API_KEY={{ metacheck_groq_api_key }}
{% endif %}

# PsyArXiv reports (prototype; api/psyarxiv_reports.R): the folder, how many
# newest preprints get a report, and the key of the delete links.
PSYARXIV_REPORTS_DIR={{ metacheck_psyarxiv_reports_dir }}
PSYARXIV_REPORTS_NEWEST={{ metacheck_psyarxiv_reports }}
PSYARXIV_REPORTS_SECRET={{ psyarxiv_reports_secret.stdout }}

# This workspace's public address, for links in messages.
METACHECK_SITE_URL={{ metacheck_site_url }}
{% if metacheck_discord_value | length > 0 %}

# A Discord channel's webhook (metacheck_discord_webhook): finished and failed
# PsyArXiv reports, reported mistakes, problems the server watch finds.
DISCORD_WEBHOOK_URL={{ metacheck_discord_value }}
{% endif %}
{% if metacheck_mail_to != 'none' and metacheck_smtp_url != 'none' %}

# Where "report a mistake" messages are mailed, and through which SMTP server.
MAIL_TO={{ metacheck_mail_to }}
{% if metacheck_mail_from != 'none' %}
MAIL_FROM={{ metacheck_mail_from }}
{% endif %}
SMTP_URL={{ metacheck_smtp_url }}
SMTP_USER={{ metacheck_smtp_user if metacheck_smtp_user != 'none' else '' }}
SMTP_PASSWORD={{ metacheck_smtp_password if metacheck_smtp_password != 'none' else '' }}
{% endif %}
